# Copy to .env for local development: cp .env.example .env
# Values below match docker-compose.yml, so the app connects to the local stack out of the box.
# Real secrets (prod DB URL, JWT/Stripe keys) come from the platform secret store, never this file.

NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://cafepos:cafepos_dev_pw@localhost:5433/cafepos
REDIS_URL=redis://localhost:6379

# Comma-separated browser origins allowed to call the API (KDS, public board).
# Leave empty for same-origin/native clients — CORS stays off unless opted into.
CORS_ORIGINS=

# HS256 signing key for staff access tokens. Min 32 chars; generate your own with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# This placeholder is deliberately not a working secret — the app refuses to boot
# until you replace it, so a dev key can never be inherited by an environment.
JWT_SECRET=replace-me-with-a-generated-secret

# Token lifetimes in seconds. Defaults match §6.1/§6.2; override only if you
# have a reason the design doc doesn't already cover.
# ACCESS_TOKEN_TTL_SECONDS=900
# REFRESH_TOKEN_TTL_SECONDS=1209600
# PAIRING_CODE_TTL_SECONDS=600

# How this cafe trades. Every value here is one the owner can be wrong about in
# a way no test would catch, so all four are configurable rather than buried in
# the ordering path (§16's product checklist). The defaults are the §3.5
# single-cafe assumptions and are what the app uses when these stay commented.
#
#   BUSINESS_TIMEZONE       IANA name; "local" in "05:00 local" means this zone.
#   BUSINESS_DAY_START_HOUR When the trading day rolls over (B7, E10). 05:00 is
#                           after any cafe closes and before any opens, so an
#                           order at 00:30 keeps the running shift's queue
#                           number and Z-report line.
#   VAT_BASIS_POINTS        Extracted from a VAT-inclusive price, never added to
#                           it (§3.3). 700 = Thailand's 7%; 0 if unregistered.
#   CURRENCY                ISO 4217. Single-currency by design (§3.5).
#   ORDER_EXPIRY_SECONDS    How long an unpaid order holds its queue number
#                           before the expiry job reclaims it (FR-10).
# BUSINESS_TIMEZONE=Asia/Bangkok
# BUSINESS_DAY_START_HOUR=5
# VAT_BASIS_POINTS=700
# CURRENCY=THB
# ORDER_EXPIRY_SECONDS=600

# Object storage for item images (§10, §12.4). These values match the MinIO
# service in docker-compose, so uploads work against a local checkout with no
# cloud account. In production these point at the real bucket and CDN, and the
# keys come from the platform secret store.
S3_BUCKET=cafepos-media
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=cafepos
S3_SECRET_ACCESS_KEY=cafepos_dev_secret

# Unset in production: the SDK then resolves the real regional AWS endpoint.
S3_ENDPOINT=http://localhost:9000

# Public origin images are read from — the CDN in front of the bucket. Must be
# https anywhere but localhost; kiosks render these, and a plaintext image
# source is both tamperable and mixed content.
S3_PUBLIC_BASE_URL=http://localhost:9000/cafepos-media

# Creates the bucket at boot when missing. Fine for MinIO and CI; leave false
# in production, where the bucket is infrastructure with lifecycle and access
# policies attached and an app that can conjure one hides a misconfigured
# account.
S3_AUTO_CREATE_BUCKET=true

# Payment gateway (§10.5, §12.4). Unlike the values above, there is no local
# stand-in that works out of the box — get a test key from the Dashboard:
#   https://dashboard.stripe.com/test/apikeys
#
# Prefer a RESTRICTED key (rk_test_...) over a full secret key (sk_test_...).
# Scope it to exactly two things:
#   PaymentIntents  Write  (create, cancel, retrieve)
#   Charges         Read   (resolveMethod expands latest_charge for the rail)
# No refund permission: refunds here are bookkeeping against the till and the
# provider port has no refund verb. A key scoped this way cannot read every
# customer or rotate the account's keys if it leaks. sk_ is accepted so a first
# spike is not blocked on minting one.
#
# Charges: Read fails quietly if you omit it — resolveMethod swallows its errors
# by contract, so every payment lands with a null method and it looks like a
# labelling quirk rather than a permission problem.
STRIPE_SECRET_KEY=rk_test_replace-me

# Signing secret(s) for POST /webhooks/stripe. Comma-separated, newest first:
# §10.5 rotates this with a 24-hour dual-accept window, and an endpoint that
# knows only one secret drops every event signed with the other.
#
# Local development gets one from the CLI, which prints it on startup:
#   stripe listen --forward-to localhost:3000/api/v1/webhooks/stripe
STRIPE_WEBHOOK_SECRETS=whsec_replace-me

# Points the Stripe client somewhere other than api.stripe.com. Leave unset:
# local development talks to real Stripe in test mode, because that is the only
# place PromptPay, dynamic payment methods and the Dashboard behave the way they
# will in production.
#
# CI sets it to stripe-mock, which speaks the real protocol and authenticates
# nothing — so the payment suites exercise the actual SDK and adapter without a
# key and without the network. To reproduce a CI run locally:
#   docker compose up -d stripe-mock
#   STRIPE_API_BASE=http://localhost:12111 pnpm test:e2e
# STRIPE_API_BASE=http://localhost:12111
