pnpm exec lint-staged

# Same rules as the CI "Scan for secrets" step, applied to staged changes only.
# A secret that reaches a public history stays exposed after it is removed, so
# this is the one check that cannot wait for CI.
if command -v gitleaks >/dev/null 2>&1; then
  gitleaks git --pre-commit --staged --redact -v --no-banner --config .gitleaks.toml
elif docker info >/dev/null 2>&1; then
  # Same image and version as .github/workflows/ci.yml.
  ROOT=$(pwd -W 2>/dev/null || pwd)
  MSYS_NO_PATHCONV=1 docker run --rm \
    -e GIT_CONFIG_COUNT=1 -e GIT_CONFIG_KEY_0=safe.directory -e GIT_CONFIG_VALUE_0=/repo \
    -v "$ROOT:/repo:ro" \
    zricethezav/gitleaks:v8.30.1 \
    git /repo --pre-commit --staged --redact -v --no-banner --config /repo/.gitleaks.toml
else
  echo "pre-commit: secret scan SKIPPED (no gitleaks on PATH and Docker is not running). CI will still scan." >&2
fi
