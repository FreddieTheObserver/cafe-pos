{
  "name": "cafe-pos",
  "version": "0.0.1",
  "private": true,
  "description": "",
  "license": "UNLICENSED",
  "packageManager": "pnpm@10.33.0+sha512.10568bb4a6afb58c9eb3630da90cc9516417abebd3fabbe6739f0ae795728da1491e9db5a544c76ad8eb7570f5c4bb3d6c637b2cb41bfdcdb47fa823c8649319",
  "scripts": {
    "build": "pnpm -r --if-present run build",
    "typecheck": "pnpm -r --if-present run typecheck",
    "test": "pnpm -r --if-present run test",
    "lint": "pnpm -r --if-present run lint",
    "format": "pnpm -r --if-present run format",
    "start": "pnpm --filter @cafepos/api run start",
    "start:dev": "pnpm --filter @cafepos/api run start:dev",
    "start:prod": "pnpm --filter @cafepos/api run start:prod",
    "test:e2e": "pnpm --filter @cafepos/api run test:e2e",
    "db:generate": "pnpm --filter @cafepos/api run db:generate",
    "db:migrate": "pnpm --filter @cafepos/api run db:migrate",
    "db:seed": "pnpm --filter @cafepos/api run db:seed",
    "db:studio": "pnpm --filter @cafepos/api run db:studio",
    "openapi": "pnpm --filter @cafepos/api run openapi",
    "openapi:check": "pnpm --filter @cafepos/api run openapi:check",
    "prepare": "husky || true"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10"
  },
  "lint-staged": {
    "apps/*/{src,test}/**/*.ts": "prettier --write"
  }
